rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'Admin';
    }

    // ==========================================
    // USERS COLLECTION (Document ID == Auth UID)
    // ==========================================
    match /users/{userId} {
      // Authenticated users can view profiles (author names, contact info for item return)
      allow read: if isAuthenticated();

      // On registration:
      // 1. Can only create their own profile document (document ID == auth UID)
      // 2. Can ONLY choose 'Student' or 'Teacher & Staff'
      // 3. STRICT: Never allow self-granting 'Admin' role
      // 4. Default isSuspended must be false
      allow create: if isOwner(userId)
                    && request.resource.data.role in ['Student', 'Teacher & Staff']
                    && request.resource.data.role != 'Admin'
                    && request.resource.data.isSuspended == false;

      // On profile update:
      // - Regular users can update contact info, but CANNOT modify role or suspension status
      // - Only verified Admins can change roles or suspend/unsuspend users
      allow update: if (
        isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.isSuspended == resource.data.isSuspended
      ) || isAdmin();

      // Only admins can delete user records
      allow delete: if isAdmin();
    }

    // ==========================================
    // ITEMS / LISTINGS (Lost & Found Posts)
    // ==========================================
    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==========================================
    // CLAIMS
    // ==========================================
    match /claims/{claimId} {
      allow read: if isAuthenticated() && (resource.data.claimantId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.claimantId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // NOTIFICATIONS
    // ==========================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}

